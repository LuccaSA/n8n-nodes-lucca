{
	"version": "0.6.0",
	"name": "@lucca/n8n-nodes-lucca",
	"description": "A n8n community node for Lucca's Public API",
	"license": "MIT",
	"homepage": "https://lucca.fr",
	"keywords": [
		"n8n-community-node-package",
		"lucca",
		"human-resources"
	],
	"author": {
		"name": "The Lucca integration team",
		"email": "integrations@luccasoftware.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/LuccaSA/n8n-nodes-lucca.git"
	},
	"scripts": {
		"generate": "tsx lib/build/generateOpenApiProperties.cts",
		"build": "npm run generate && n8n-node build",
		"build:watch": "tsc --watch",
		"lint": "n8n-node lint",
		"cert": "mkdir .cert&& cd .cert&& mkcert localhost ::5678",
		"dev": "npm run build && n8n start",
		"dev:https": "set N8N_PROTOCOL=https&& set N8N_SSL_CERT=./.cert/localhost.pem && set N8N_SSL_KEY=./.cert/localhost-key.pem && npm run build && n8n start",
		"lint:fix": "n8n-node lint --fix",
		"postversion": "git push"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/LuccaOAuth2Api.credentials.js",
			"dist/credentials/LuccaWebhookSignatureApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Lucca/Lucca.node.js",
			"dist/nodes/LuccaWebhooks/LuccaWebhooks.node.js"
		]
	},
	"devDependencies": {
		"@devlikeapro/n8n-openapi-node": "0.1.4",
		"@n8n/node-cli": "0.33.1",
		"@types/express": "5.0.6",
		"openapi-types": "12.1.3",
		"prettier": "3.9.5",
		"release-it": "20.2.1",
		"tsx": "4.23.1",
		"typescript": "6.0.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
